name = "Async"
description = "Subagent fan-out flow: an Opus main loop coordinates and verifies; spawned subagents do the work — Sonnet codes from spec + plan, a Fable reviewer and a Codex reviewer check the diff. Run this pipeline with a Claude Code (Opus) execution agent."

[[stage]]
id = "orchestrate"
label = "Orchestrate (auto-drive)"
default_enabled = false
prompt = "Have the orchestrator agent pick this card up and drive it to done autonomously, running the card's pipeline stages in order — regardless of which board column the card is in (it may be started even from Todo)."

[[stage]]
id = "spec"
label = "Create spec"
default_enabled = true
prompt = "Write a technical spec for this card and save it to `SPEC.md` at the repo root before implementing."

[[stage]]
id = "plan"
label = "Create plan"
default_enabled = true
prompt = "Write a step-by-step implementation plan and save it to `IMPLEMENTATION_PLAN.md` at the repo root."

[[stage]]
id = "code-subagent"
label = "Code via Sonnet subagent"
default_enabled = true
prompt = "Do NOT write the implementation yourself. Spawn the `vibe-kanban-indie:coder` subagent (Sonnet model; fall back to a generic Agent with model: 'sonnet' if the plugin agent is unavailable) to implement the card strictly from `SPEC.md` and `IMPLEMENTATION_PLAN.md` — pass the workspace-root path plus the card description in the subagent prompt, and instruct it to follow the plan step by step and report what it changed. When it returns, verify the result compiles and passes checks (`pnpm run check` / `cargo test` as applicable); if the subagent's work is incomplete or broken, spawn a follow-up coder subagent with the concrete gaps rather than fixing the code in the main loop."

[[stage]]
id = "review-fable"
label = "Review via Fable subagent"
default_enabled = true
prompt = "Spawn a review subagent on the Fable model (Agent tool with model: 'fable') to review the full diff of this card for correctness bugs, spec deviations, and edge cases — give it the diff, `SPEC.md`, and `IMPLEMENTATION_PLAN.md`. This review may run concurrently with the Codex review stage: spawn both, then collect. Address confirmed findings by dispatching fix work to a Sonnet coding subagent, then re-verify."

[[stage]]
id = "review-codex"
label = "Review via Codex"
default_enabled = true
prompt = "Run an independent Codex review of the card's diff (the codex-review skill / Codex CLI), iterating until it has no significant findings. This may run concurrently with the Fable review stage. Address confirmed findings by dispatching fix work to a Sonnet coding subagent, then re-verify."

[[stage]]
id = "merge"
label = "Merge to base"
default_enabled = false
prompt = "When the work is implemented and reviewed, merge this card's branch into the base branch."

[[stage]]
id = "pr"
label = "Open pull request"
default_enabled = false
prompt = "When the work is implemented and reviewed, open a pull request for this card against the base branch."
