# Example config bundle for Vibe Kanban (import/export format).
#
# The SQLite database is the source of truth for projects, repos, links, and
# kanban columns — create and edit them in the app. This file is an explicit,
# portable export/import format for that *static* config (NOT issues, workspaces,
# or tags).
#
# Import this file:   vibe-kanban import path/to/this.toml
#   (or POST its contents to /api/config/import)
# Export current DB:  vibe-kanban export path/to/out.toml
#   (or GET /api/config/export)
#
# Import is non-destructive: rows are matched by `id` (then by name/path),
# existing rows are updated, new ones inserted, and nothing is ever deleted.
# Default path when none is given: $VIBE_KANBAN_PROJECTS_CONFIG, else
# ~/.vibe-kanban/projects.toml.
#
# An export also includes a top-level `profiles_json = "..."` string holding your
# executor profiles (agents); importing it restores those profile overrides.

# Display name for the predefined local user (issue creator/assignee).
local_user_name = "Local"

# ---------------------------------------------------------------------------
# Repos — one block per git repository. `path` is the unique anchor.
# ---------------------------------------------------------------------------
[[repo]]
# id is optional; generated on import if omitted. Exports always include it so a
# re-import updates the same row instead of inserting a duplicate.
# id = "00000000-0000-0000-0000-000000000000"
path = "~/code/acme-api"
display_name = "Acme API"
default_target_branch = "main"
# default_working_dir = "."
# copy_files = [".env", "config/local.toml"]
parallel_setup_script = false
# setup_script = "pnpm install"
# cleanup_script = ""
# archive_script = ""
# dev_server_script = "pnpm dev"

[[repo]]
path = "~/code/acme-web"
display_name = "Acme Web"
default_target_branch = "main"
parallel_setup_script = false

# ---------------------------------------------------------------------------
# Projects — group repos and define kanban columns.
# ---------------------------------------------------------------------------
[[project]]
name = "Acme"
# key is the per-project issue prefix (e.g. "ACME" -> "ACME-5"); derived from
# the name if omitted.
key = "ACME"
color = "#3b82f6"
# default_agent_working_dir = "."
# Repo paths grouped under this project (must match a [[repo]].path above).
repos = ["~/code/acme-api", "~/code/acme-web"]
# Kanban columns, created in order on import only if the project has none yet.
# Once a project has columns they are managed in the app and this is ignored.
statuses = ["Todo", "In Progress", "In Review", "Done"]
