# Example projects.toml for running Vibe Kanban fully locally.
#
# Copy this to ~/.vibe-kanban/projects.toml (or point $VIBE_KANBAN_PROJECTS_CONFIG
# at it) and edit to taste. This file is the source of truth for project and repo
# *config*; the SQLite database keeps matching rows as an id-anchored mirror so
# issues, workspaces, and kanban state work normally.
#
# How it syncs:
# - On startup the file is reconciled into the database (the file wins for any
#   field it declares). Stable `id`s are generated and written back here, and any
#   project/repo created in the UI is exported back into this file.
# - Creating/editing projects or repos in the UI writes the change back here too.
# - Reconcile never deletes: removing a block by hand will reappear on next start.
#   To delete a project or repo, use the UI (deletes cascade to issues/links).

# Display name for the predefined local user (issue creator/assignee).
local_user_name = "Local"

# ---------------------------------------------------------------------------
# Repos — one block per git repository. `path` is the unique anchor.
# ---------------------------------------------------------------------------
[[repo]]
# id is optional; generated and written back on first run if omitted.
# id = "00000000-0000-0000-0000-000000000000"
path = "~/code/acme-api"
display_name = "Acme API"
default_target_branch = "main"
# default_working_dir = "."
# copy_files = [".env", "config/local.toml"]
parallel_setup_script = false
# setup_script = "pnpm install"
# cleanup_script = ""
# archive_script = ""
# dev_server_script = "pnpm dev"

[[repo]]
path = "~/code/acme-web"
display_name = "Acme Web"
default_target_branch = "main"
parallel_setup_script = false

# ---------------------------------------------------------------------------
# Projects — group repos and define kanban columns.
# ---------------------------------------------------------------------------
[[project]]
name = "Acme"
# key is the per-project issue prefix (e.g. "ACME" -> "ACME-5"); derived from
# the name if omitted.
key = "ACME"
color = "#3b82f6"
# default_agent_working_dir = "."
# Repo paths grouped under this project (must match a [[repo]].path above).
repos = ["~/code/acme-api", "~/code/acme-web"]
# Kanban columns, created in order on first reconcile only. Afterwards columns
# are managed in the app (this field is ignored once the project has any).
statuses = ["Todo", "In Progress", "In Review", "Done"]
